# --- DocuSeal (Test Mode — separate key, free, never charged) ---------------
DOCUSEAL_API_KEY=
DOCUSEAL_BASE_URL=https://api.docuseal.com
DOCUSEAL_TDS_TEMPLATE_ID=

# Proves an inbound webhook is really from DocuSeal. /api/webhooks/docuseal
# FAILS CLOSED without one: an unauthenticated POST that marks a disclosure
# signed is a forged signature on a document executed under penalty.
#
# Console -> Webhooks -> your webhook -> Security -> HMAC. Reveal the masked
# whsec_... value and paste it here. Point the webhook at
# https://<your-host>/api/webhooks/docuseal and subscribe to form.completed.
DOCUSEAL_WEBHOOK_SECRET=

# Fallback for self-hosted DocuSeal without HMAC: the arbitrary key/value pair
# from the Security -> Secret tab, sent as a request header. Weaker — it is a
# bearer token repeated on every call and it says nothing about the body — so
# only set these when DOCUSEAL_WEBHOOK_SECRET is not available.
DOCUSEAL_WEBHOOK_HEADER=
DOCUSEAL_WEBHOOK_HEADER_VALUE=

# --- OpenAI Realtime (voice) -----------------------------------------------
# Server-side only. Never expose to the client — mint an ephemeral session
# token per connection instead.
OPENAI_API_KEY=

# --- Database (Supabase Postgres) -------------------------------------------
# Use the SESSION pooler URI from Connect -> ORMs (port 5432).
#
# Not the transaction pooler (6543): drizzle-kit migrate needs prepared
# statements. Not the direct db.<ref>.supabase.co host either: that is
# IPv6-only on new projects.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Auth -------------------------------------------------------------------
# Signs agent session cookies and seller disclosure tokens.
AUTH_SECRET=
SELLER_TOKEN_TTL_DAYS=14

# The origin magic links are built from. A stale value here is the failure that
# looks like nothing: the link sends, the seller clicks, and lands on localhost.
# In production set it to the deployed origin, e.g.
#   APP_URL=https://tds-agents.vercel.app
APP_URL=http://localhost:3000
