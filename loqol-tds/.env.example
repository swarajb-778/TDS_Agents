# --- DocuSeal (Test Mode — separate key, free, never charged) ---------------
DOCUSEAL_API_KEY=
DOCUSEAL_BASE_URL=https://api.docuseal.com
DOCUSEAL_TDS_TEMPLATE_ID=

# --- OpenAI Realtime (voice) -----------------------------------------------
# Server-side only. Never expose to the client — mint an ephemeral session
# token per connection instead.
OPENAI_API_KEY=

# --- Database (Supabase Postgres) -------------------------------------------
# Use the SESSION pooler URI from Connect -> ORMs (port 5432).
#
# Not the transaction pooler (6543): drizzle-kit migrate needs prepared
# statements. Not the direct db.<ref>.supabase.co host either: that is
# IPv6-only on new projects.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Auth -------------------------------------------------------------------
# Signs agent session cookies and seller disclosure tokens.
AUTH_SECRET=
SELLER_TOKEN_TTL_DAYS=14

APP_URL=http://localhost:3000
