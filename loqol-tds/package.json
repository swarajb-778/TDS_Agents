{
  "name": "loqol-tds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "California TDS seller disclosure \u2014 question registry, flow engine, and DocuSeal mapping",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "smoke": "tsx scripts/smoke.ts",
